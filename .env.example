# Copy this file to .env for shared defaults, or enter these values on first run.
# Do not commit real credentials.

DEFAULT_FEISHU_APP_ID=your_feishu_app_id
DEFAULT_FEISHU_APP_SECRET=your_feishu_app_secret

POLL_INTERVAL=0.01
IDLE_THRESHOLD_MINUTES=10

# 「链接」列写入方式：auto=按飞书实际列类型自动选择（推荐）；text=强制纯文本；url=强制超链接对象
LINK_WRITE_MODE=auto

FIELD_QUALIFIED=是否违规
FIELD_TASK=采集任务
FIELD_SOURCE_LABEL=来源标签
FIELD_BEHAVIOR_TAGS=行为标签
FIELD_RECORDED_AT=记录时间
FIELD_WRITE_STATUS=写入状态
FIELD_DEDUPE_KEY=去重 Key
